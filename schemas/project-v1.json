{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/project-v1.json",
  "title": "InvestingOS project v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "nodes",
    "edges",
    "views"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "hierarchy",
              "network",
              "pathway"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "view"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "format": "uuid"
          },
          "target": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "contains",
              "part_of",
              "requires",
              "related_to",
              "supports",
              "contradicts",
              "alternative_to"
            ]
          },
          "view": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "author",
          "accessed",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "accessed": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "local_path": {
            "type": "string"
          },
          "extracted_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "year": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "publication_type": {
            "type": "string"
          },
          "review_due": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "sources",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "enum": [
              "unverified",
              "supported",
              "disputed",
              "outdated"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "research_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "node",
          "priority",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string"
          },
          "node": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "done"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source",
          "locator",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claim": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "format": "uuid"
          },
          "locator": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "node",
          "level",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "node": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "learning_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "competencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  }
}
